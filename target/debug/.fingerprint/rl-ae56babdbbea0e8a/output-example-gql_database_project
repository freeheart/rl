rom `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"examples\\gql_database_project.rs","byte_start":12750,"byte_end":12765,"line_start":390,"line_end":390,"column_start":82,"column_end":97,"is_primary":true,"text":[{"text":"        resolvers.insert(\"Query\".to_string(), Arc::new(DefaultQueryResolver::new(storage.clone())));","highlight_start":82,"highlight_end":97}],"label":"`GQLStorage` cannot be made into an object","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be \"dyn-compatible\" it needs to allow building a vtable to allow the call to be resolvable dynamically; for more information visit <https://doc.rust-lang.org/reference/items/traits.html#object-safety>","code":null,"level":"note","spans":[{"file_name":"examples\\gql_database_project.rs","byte_start":23312,"byte_end":23322,"line_start":710,"line_end":710,"column_start":11,"column_end":21,"is_primary":false,"text":[{"text":"pub trait GQLStorage: Send + Sync {","highlight_start":11,"highlight_end":21}],"label":"this trait cannot be made into an object...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"examples\\gql_database_project.rs","byte_start":23352,"byte_end":23355,"line_start":711,"line_end":711,"column_start":14,"column_end":17,"is_primary":true,"text":[{"text":"    async fn get(&self, key: &str) -> Result<Option<serde_json::Value>, GQLDatabaseError>;","highlight_start":14,"highlight_end":17}],"label":"...because method `get` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"examples\\gql_database_project.rs","byte_start":23444,"byte_end":23447,"line_start":712,"line_end":712,"column_start":14,"column_end":17,"is_primary":true,"text":[{"text":"    async fn set(&self, key: &str, value: serde_json::Value) -> Result<(), GQLDatabaseError>;","highlight_start":14,"highlight_end":17}],"label":"...because method `set` is `async